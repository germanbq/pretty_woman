---
import "../styles/styles.css";
interface Props {
    id: string;
    name: string;
    price?: number;
    imageUrl: string;
}
const { id, name, price, imageUrl } = Astro.props;
---


<article class="product-card">
    <h2 class="card-h2" transition:name={`name-${id}`}>{name}</h2>
    <img src={imageUrl} alt={name} transition:name={`img-${id}`} loading="lazy" decoding="async"/>
    <p>{price !== undefined ? `${price.toFixed(2)}€` : ''}</p>
</article>


<style>
    .product-card {
        width: 100%;
        min-height: 260px;
        box-sizing: border-box; /*mete el padding y el border dentro del width y height*/

        
        padding: 1.25rem;
        border-radius: 20px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;

        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 26px 50px rgba(15, 23, 42, 0.12);
        border: 2px solid #aba0a0;
    }

    .product-card img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: contain;
        border-radius: 18px;
        background-color: #ffffff;
    }

    .product-card p {
        margin: 0;
        color: #162950;
        font-weight: 700;
        font-size: 1.1rem;
    }
</style>
