---
interface Props {
    filter: string;
    counts: Record<string, number>;
}

const { filter, counts } = Astro.props;
---
<nav id="filters-menu" class="filters-menu" aria-label="Menú lateral de filtros">
    <section class="title-section-filters">
        <h2 class="h2-menu-filters">Filtros</h2>
        <button id="close-filter-menu" class="close-filter-menu" type="button" aria-label="Cerrar menú de filtros">
            <i class="bi bi-x-lg"></i>
        </button>
    </section>
    <hr class="separator-menu" />

    {filter==="typeProduct" ? (
        <details class="type-filters">
            <summary >
                Tipos de producto<i class="bi bi-chevron-down"></i>  
            </summary>

            <div class="filter-options">
                {Object.entries(counts).map(([productType, count]) => (
                    <label>
                        <input type="checkbox" value={productType}/> {productType} ({count})
                    </label>
                ))}
            </div>
        </details>
    ) : (
        <details class="type-filters">
            <summary >
                Marcas<i class="bi bi-chevron-down"></i>  
            </summary>

            <div class="filter-options">
                {Object.entries(counts).map(([brand, count]) => (
                    <label>
                        <input type="checkbox" value={brand}/> {brand} ({count})
                    </label>
                ))}
            </div>
        </details>
    )
    }

    <hr class="separator-menu" />
    <button type="button" id="submit-filters-button" class="submit-filters-button" aria-label="Aplicar filtros seleccionados">
        Aplicar filtros
    </button>
    
</nav>

<script>
    document.addEventListener("astro:page-load", () => {
        const filterButton = document.querySelector<HTMLButtonElement>("#filter-button");
        const filterMenu = document.querySelector<HTMLElement>("#filters-menu");
        const closeButton = document.querySelector<HTMLButtonElement>("#close-filter-menu");

        filterButton?.addEventListener("click", () => {
            if(!filterMenu) return;
            filterMenu.classList.toggle("abierto");
            filterButton.setAttribute("aria-expanded", "true");
        })

        closeButton?.addEventListener("click", () => {
            if(!filterMenu) return;
            filterMenu.classList.toggle("abierto");
            filterButton?.setAttribute("aria-expanded", "false");
        })

        //para aplicar los filtros
        const submitButton = document.querySelector<HTMLButtonElement>("#submit-filters-button");
        const details = document.querySelector<HTMLDetailsElement>(".type-filters");
        submitButton?.addEventListener("click", () => {
            const inputs = details?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')
            const filters = Array.from(inputs ?? []).map((input) => input.value);
            document.dispatchEvent(new CustomEvent("products:filter", {
                detail: {filters}   })
            );

            if(!filterMenu) return;
            filterMenu.classList.toggle("abierto");       
        })
    })
</script>

<style>
    .filters-menu {
        position: fixed;
        top: 80px;
        right: 0;
        z-index: 1000;

        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        width: 320px;
        height: calc(100vh - 80px);
        padding-top: 2rem;

        background-color: white;
        box-shadow: -4px 0 12px rgb(0 0 0 / 20%);

        transform: translateX(100%);
        transition: transform 0.3s ease;

        color: #41444a;

        height: calc(100vh - 80px);
        overflow-y: auto;
    }

    .filters-menu.abierto {
        transform: translateX(0);
    }

    .close-filter-menu {
        font-size: 1.9rem;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .close-filter-menu:hover {
        color: #964794;
    }

    .title-section-filters {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 0 10%;
    }

    .h2-menu-filters {
        font-size: 1.5rem;
        font-weight: 600;
    }

    .type-filters summary {
        display: flex;
        justify-content: space-between;
        font-size: 1.3rem;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .type-filters summary:hover {
        color: #964794;
    }


    .type-filters[open] summary i {
        transform: rotate(180deg);
    }

    .type-filters {
        padding: 0 5%;
    }

    .filter-options {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
    }

    .filter-options label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        padding: 0.35rem 0.8rem;
    }


    .filter-options label:hover {
        color: #964794;
        background-color: #faf5fa;
    }

    .filter-options input {
        appearance: none;
        width: 22px;
        height: 22px;
        cursor: pointer;

        border: 2px solid #a6a6a6;
        border-radius: 6px;
    }

    .filter-options input:hover {
        border-color: #964794;
    }

    .filter-options input:checked {
        border-color: #964794;
        background-color: #964794;
    }

    .filter-options input:checked::after {
        content: "";
        display: block;
        width: 5px;
        height: 10px;
        margin: 2px auto;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .submit-filters-button {
        display: block;
        margin: 2rem auto;
        border: 2px;
        border-radius: 18px;
        border: 1.5px solid #000000;
        padding: 0.5rem;
        cursor: pointer;
    }

    .submit-filters-button:hover {
        color: #964794;
        border: 1px solid #964794
    }
</style>
