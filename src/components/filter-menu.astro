---
interface Props {
    filter: "brand" | "type";
    id: number;
}

const { filter, id } = Astro.props;

import type {FilterCount} from '../data-access/interfaces'
import { getBrandCountsByProductType, getProductTypeCountsByBrand } from '../data-access/querys';

let counts : FilterCount[];
if(filter ==="type"){
    counts = await getProductTypeCountsByBrand(id);
}
else {
    counts = await getBrandCountsByProductType(id);
}
---
<nav id="filters-menu" class="filters-menu" aria-label="Menú lateral de filtros" inert>
    <section class="title-section-filters">
        <h2 class="h2-menu-filters">Filtros</h2>
        <button id="close-filter-menu" class="close-filter-menu" type="button" aria-label="Cerrar menú de filtros">
            <i class="bi bi-x-lg"></i>
        </button>
    </section>
    <hr class="separator-menu" />

    <details class="type-filters">
        {filter==="type" ? (
            <summary >
                Tipos de producto<i class="bi bi-chevron-down"></i>  
            </summary>

            <div class="filter-options">
                {counts.map((count) => (
                    <label>
                        <input type="checkbox" value={count.name}/> {count.name} ({Number(count.numProducts)})
                    </label>
                ))}
            </div>
        ) : (
            <summary >
                Marcas<i class="bi bi-chevron-down"></i>  
            </summary>

            <div class="filter-options">
                {counts.map((count) => (
                    <label>
                        <input type="checkbox" value={count.name}/> {count.name} ({Number(count.numProducts)})
                    </label>
                ))}
               </div>
        )
        }
        <button type="button" id="delete-filters-button" class="delete-filters-button" aria-label="Limpiar filtros seleccionados">
            Limpiar filtros seleccionados
        </button>
    </details>

    <hr class="separator-menu" />
    <select class="filters-select" id="filters-select">
        <option value="" selected disabled>Sin orden</option>
        <option value="alf-a">Nombre: A-Z</option>
        <option value="alf-d">Nombre: Z-A</option>
        <option value="price-a">Precio de menor a mayor</option>
        <option value="price-d">Precio de mayor a menor</option>
    </select>

    <hr class="separator-menu" />
    <button type="button" id="submit-filters-button" class="submit-filters-button" aria-label="Aplicar filtros seleccionados">
        Aplicar filtros
    </button>
    
</nav>

<script>
    import { updateProductList } from "../scripts/product-list"
    import { storeFiltersURL, getFiltersURL } from "../scripts/url-storage";
    import {activateFocusTrap, deactivateFocusTrap} from "../scripts/focus-trap"
    document.addEventListener("astro:page-load", () => {
        const submitButton = document.querySelector<HTMLButtonElement>("#submit-filters-button");

        const filterButton = document.querySelector<HTMLButtonElement>("#filter-button");
        const filterMenu = document.querySelector<HTMLElement>("#filters-menu");
        const closeButton = document.querySelector<HTMLButtonElement>("#close-filter-menu");
        const details = document.querySelector<HTMLDetailsElement>(".type-filters");

        filterButton?.addEventListener("click", () => {
            if(!filterMenu) return;
            filterMenu.classList.toggle("open");
            filterMenu.toggleAttribute("inert");
            filterButton.setAttribute("aria-expanded", "true");

            activateFocusTrap(filterMenu);
        })

        closeButton?.addEventListener("click", () => {
            if(!filterMenu) return;
            filterMenu.classList.toggle("open");
            filterButton?.setAttribute("aria-expanded", "false");
            details?.removeAttribute("open");

            filterMenu.toggleAttribute("inert");
            deactivateFocusTrap();
            filterButton?.focus();
        }) 

        //para aplicar los filtros
        const select = document.querySelector<HTMLSelectElement>("#filters-select");
        submitButton?.addEventListener("click", () => { 
            //para no devolver el foco al botón si se ha ejecutado el submit después de recuperar
            //los filtros de la url
            const shouldRestoreFocus = filterMenu?.contains(document.activeElement) ?? false;

            const inputs = details?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')
            const filters = Array.from(inputs ?? []).map((input) => input.value);
            const order = select?.value;
            
            storeFiltersURL(filters, order);

            filterMenu?.dispatchEvent(new CustomEvent("products:filter", {
                detail: {filters, order}
               })
            );
            
            filterMenu?.classList.toggle("open");
            filterButton?.setAttribute("aria-expanded", "false");
            details?.removeAttribute("open");

            filterMenu?.toggleAttribute("inert");
            deactivateFocusTrap();
            if (shouldRestoreFocus) filterButton?.focus();
        })

        updateProductList();
        
        const click = getFiltersURL(select);
        if(click) {
            filterMenu?.classList.toggle("open");
            filterMenu?.toggleAttribute("inert");
            submitButton?.click();
        }
        //botón limpiar filtros seleccionados
        const deleteButton = document.querySelector<HTMLButtonElement>("#delete-filters-button");
        deleteButton?.addEventListener("click", () => {
            const inputs = details?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')
            inputs?.forEach((input) => {
                input.checked = false;
            })
        })
    })
</script>

<style>
    .filters-menu {
        position: fixed;
        right: 0;
        z-index: 1050;
        top: var(--header-height, 80px);
        box-sizing: border-box;

        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        width: 320px;
        padding-top: 2rem;

        background-color: white;
        box-shadow: -4px 0 12px rgb(0 0 0 / 20%);

        transform: translateX(100%);
        transition: transform 0.3s ease;

        color: #41444a;

        height: calc(100vh - 80px);
        overflow-y: auto;
    }

    .filters-menu.open {
        transform: translateX(0);
    }

    .filters-menu > .separator-menu {
        flex-shrink: 0;
    }

    .close-filter-menu {
        font-size: 1.9rem;
        cursor: pointer;
        transition: color 0.2s ease;
        &:hover, &:focus-visible {
            color: #964794;
            outline: none;
        }
    }

    .title-section-filters {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 0 10%;
    }

    .h2-menu-filters {
        font-size: 1.5rem;
        font-weight: 600;
    }

    .type-filters summary {
        display: flex;
        justify-content: space-between;
        font-size: 1.3rem;
        cursor: pointer;
        transition: color 0.2s ease;

        &:hover, &:focus-visible {
            color: #964794;
            outline: none;
        }
    }


    .type-filters[open] summary i {
        transform: rotate(180deg);
    }

    .type-filters {
        padding: 0 5%;
    }

    .filter-options {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
    }

    .filter-options label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        padding: 0.35rem 0.8rem;

        &:hover {
            color: #964794;
            background-color: #faf5fa;
        }
    }
    .filter-options input {
        appearance: none;
        width: 22px;
        height: 22px;
        cursor: pointer;

        border: 2px solid #a6a6a6;
        border-radius: 6px;

        &:hover, &:focus-visible {
            border-color: #964794;
            outline: none;
        }
    }

    .filter-options input:checked {
        border-color: #964794;
        background-color: #964794;
    }

    .filter-options input:checked::after {
        content: "";
        display: block;
        width: 5px;
        height: 10px;
        margin: 2px auto;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .submit-filters-button {
        display: block;
        margin: 2rem auto;
        border-radius: 18px;
        border: 1.5px solid #000000;
        padding: 0.5rem;
        cursor: pointer;

        &:hover, &:focus-visible {
            color: #964794;
            border: 1px solid #964794;
            outline: none;          
        }
    }       

    .filters-select {
        display: block;
        margin: 0 auto;
        border: 1px solid black;
        border-radius: 18px;
        height: 6%;
        padding: 0.2rem 0.5rem;
        cursor: pointer;
    }

    .delete-filters-button {
        display: block;
        margin: 2rem auto 0 auto;
        border-radius: 18px;
        border: 1px solid #000000;
        padding: 0.1rem 0.5rem;
        cursor: pointer;

        &:hover, &:focus-visible {
            color: #964794;
            border: 1px solid #964794;
            outline: none;
        }
    }
</style>
