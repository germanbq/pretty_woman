---
import SideSubmenu from './side-submenu.astro'
---
<nav id="opt-side-menu" class="opt-side-menu" aria-label="Menú lateral de opciones" inert>
    <div class="side-menu-div"><a href="/" data-astro-reload>Inicio</a></div>
    <hr class="separator-menu" />
    <div class="side-menu-div">
        <button id="brands-menu-button" aria-label="Abrir menú de marcas" aria-expanded="false" class="submenus-open-button">
        Marcas<i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>
    <hr class="separator-menu" />
    <div class="side-menu-div">
        <button id="types-menu-button" aria-label="Abrir menú de tipos de producto" aria-expanded="false" class="submenus-open-button">
            Tipos de producto<i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>
    <hr class="separator-menu" />
    <div class="side-menu-div"><a class="close-menu-link" href="/#about-us">Sobre nosotros</a></div>
    <hr class="separator-menu" />
    <div class="side-menu-div"><a class="close-menu-link" href="/#contact">Contacto</a></div>
    <hr class="separator-menu" />

    <SideSubmenu type="Marcas" menuId="brands-side-menu" closeButtonId="brand-menu-left-button"/>
    <SideSubmenu type="Tipos de producto" menuId="types-side-menu" closeButtonId="type-menu-left-button"/>
</nav>

<script>
    import { initSideSubmenus } from "../scripts/side-submenus"
    document.addEventListener("astro:page-load", () => {
        initSideSubmenus();
    })
</script>

<style>
    .opt-side-menu {
        position: fixed;
        left: 0;
        z-index: 1150;
        top: var(--header-height, 80px);
        box-sizing: border-box;

        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        width: 280px;
        height: calc(100vh - 80px);
        padding-top: 2rem;

        background-color: white;
        box-shadow: 4px 0 12px rgb(0 0 0 / 20%);

        overflow-y: auto;
        overflow-x: hidden;
        transform: translateX(-100%);
        transition: transform 0.3s ease;

        color: #41444a
    }

    .opt-side-menu.open {
        transform: translateX(0);
    }

    .opt-side-menu a,
    .opt-side-menu button {
        font-weight: 500;
        cursor: pointer;
        padding-left: 10%;
        font-size: 1.15rem;
    }

    .submenus-open-button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-right: 10%;
    }
</style>
