---
import { getAllProducts } from '../data-access/querys';
const products = await getAllProducts();
---
<nav id="sch-side-menu" class="sch-side-menu" aria-label="Menú lateral de búsqueda" inert>
    <section class="search-section">
        <h2 class="search-menu-h2">Buscar</h2>
        <hr class="separator-menu" />
        <section class="section-input">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="search-input" class="search-input" placeholder="Buscar " type="search" name="q" 
            aria-label="Buscar" autocapitalize="off" autocomplete="off" spellcheck="false">
        </section>
    </section>
    <section class="search-results">
        {products.map((product) => (
            <div class="sch-product-article-div" data-name={product.name.toLowerCase()} hidden>
                <a href={`/products/${product.id}`} class="sch-product-article">
                <img class="sch-product-img" src={product.image_path} loading="lazy" decoding="async"/>
                <div class="sch-product-info pt-2">
                    <h2 class="sch-product-article-title">{product.name}</h2>
                    <h3>{Number(product.price).toFixed(2)}€</h3>
                </div>
            </a>
            <hr class="separator-menu my-2"/>
            </div>
        ))}
        <p class="sch-text" id="sch-begin-text">
            Escriba el nombre del producto para encontrar coincidencias.
        </p>
        <p class="sch-text" id="sch-no-results" hidden>
            No se encontraron productos.
        </p>
    </section>
</nav>

<script>
    import {closeAllMenus} from "../scripts/close-menus"
    import {activateFocusTrap, deactivateFocusTrap} from "../scripts/focus-trap"
    //menú busqueda
    document.addEventListener("astro:page-load", () => {//el astro:page-load permite que después de navegar sigan funcionando los efectos
        const schMenuButton = document.querySelector<HTMLButtonElement>("#sch-menu-button");
        const schSideMenu = document.querySelector<HTMLElement>("#sch-side-menu");
        const schMenuIcon = schMenuButton?.querySelector<HTMLElement>("i");

        const updateSearchMenu = (isOpen: boolean) => {
            schMenuButton?.setAttribute("aria-expanded", String(isOpen));
            schMenuButton?.setAttribute("aria-label", isOpen ? "Cerrar menú de búsqueda" : "Abrir menú de búsqueda");

            schMenuIcon?.classList.toggle("fa-magnifying-glass", !isOpen);
            schMenuIcon?.classList.toggle("bi-x-lg", isOpen);
        };
        
        schMenuButton?.addEventListener("click", () => {
            if(!schSideMenu) return;

            closeAllMenus(schSideMenu);

            schSideMenu.classList.toggle("open");
            schSideMenu?.toggleAttribute("inert");
            const isOpen = schSideMenu.classList.contains("open");

            if(isOpen) {
                activateFocusTrap(schSideMenu);
            }
            else {
                deactivateFocusTrap();
                schMenuButton?.focus();
            }

            updateSearchMenu(isOpen);
        });

        const overlay = document.querySelector<HTMLElement>("#menu-overlay");
        overlay?.addEventListener("menus:closed", () => {
            updateSearchMenu(false);
        });
    });

    //buscador
    document.addEventListener("astro:page-load", () => {
        const search = document.querySelector<HTMLInputElement>("#search-input");
        const products = document.querySelectorAll<HTMLElement>(".sch-product-article-div");

        const noResults = document.querySelector<HTMLElement>("#sch-no-results");
        const beginText = document.querySelector<HTMLElement>("#sch-begin-text");

        search?.addEventListener("input", () => {
            const searchedEle = search.value.toLowerCase().trim();
            let visibleProducts = 0;
            
            products.forEach((product) => {
                const name = product.dataset.name ?? "";
                const finds = name.includes(searchedEle);

                if(searchedEle.length > 2) product.hidden = !finds;
                else product.hidden = true;

                if(finds) visibleProducts++;
            });
            
            if(searchedEle.length < 3) visibleProducts = 0; 
            if(beginText) beginText.hidden = visibleProducts > 0 || searchedEle.length > 2;
            if(noResults) noResults.hidden = visibleProducts > 0 || searchedEle.length < 3;
        });
    });
</script>

<style>
    .sch-side-menu {
        position: fixed;
        right: 0;
        z-index: 1100;
        top: var(--header-height, 80px);
        box-sizing: border-box;

        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        width: 320px;
        height: calc(100vh - 80px);
        padding-top: 2rem;

        background-color: white;
        box-shadow: -4px 0 12px rgb(0 0 0 / 20%);

        transform: translateX(100%);
        transition: transform 0.3s ease;

        color: #41444a
    }

    .sch-side-menu.open {
        transform: translateX(0);
    }

    .search-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;       
    }

    .section-input {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: center;
        padding-left: 1.5rem;
        font-size: 1.3rem;
    }

    .search-menu-h2 {
        font-size: 1.5rem;
        font-weight: 600;
        text-align: center;
    }

    .search-input {
        border: 1px solid #000000;
        border-radius: 12px;
        width: 80%;
        padding: 0.3rem;
    }

    .search-results {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
    }

    .sch-product-article-div {
        display: contents;
    }

    .sch-product-article {
        height: 22%;
        display: flex;
        flex-direction: row;
        gap: 10%;
        padding-left: 5%;
        font-weight: 500;
        font-size: 1.1rem;
    }

    .sch-product-img {
        height: 100%;
    }

    .sch-product-info {
        flex: 1;
        min-width: 0;
    }

    .sch-product-article-title {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

    .sch-text {
        text-align: center;
    }
</style>
