---
import brands from '../data/brands.json';
import typeProducts from '../data/product-types.json'
import products from '../data/products.json'
---
<main class="header">
    <button class="header-options" id="boton-menu-opt" aria-label="Abrir menú" aria-expanded="false">
        <i class="fa-solid fa-bars"></i>
    </button>
    <a class="header-logo" href="/">
        <img src={"/images/logo_header.webp"} alt="Logo del header"/>
    </a>
    <button class="header-search" id="boton-menu-sch" aria-label="Abrir menú" aria-expanded="false">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
</main>

<div id="menu-overlay" class="menu-overlay" aria-hidden="true"></div>

<nav id="menu-lateral-opt" class="menu-lateral-opt" aria-label="Menú lateral de opciones">
    <div class="div-menu-lateral"><a href="/">Inicio</a></div>
    <hr class="separator-menu" />
    <div class="div-menu-lateral">
        <button id="button-menu-brands" aria-label="Abrir menú de marcas" aria-expanded="false" class="buttons-open-submenus">
        Marcas<i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>
    <hr class="separator-menu" />
    <div class="div-menu-lateral">
        <button id="button-menu-types" aria-label="Abrir menú de tipos de producto" aria-expanded="false" class="buttons-open-submenus">
            Tipos de producto<i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>
    <hr class="separator-menu" />
    <div class="div-menu-lateral"><a class="link-cerrar-menu" href="/#sobre-nosotros">Sobre nosotros</a></div>
    <hr class="separator-menu" />
    <div class="div-menu-lateral"><a class="link-cerrar-menu" href="/#contacto">Contacto</a></div>
    <hr class="separator-menu" />

</nav>

<nav id="menu-lateral-brands" class="submenus-lateral" aria-label="Menú lateral de marcas">
    <section class="menu-lateral-title">
        <button  class="cursor-pointer" id="boton-menu-bra-left" aria-label="Cerrar submenú marcas">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        <h2>Marcas</h2>
    </section>
        
    {brands.map((brand) => (
        <hr class="separator-menu" />
        <div class="div-menu-lateral">
            <a href={`/brands/${brand.name}`}>{brand.name}</a>
        </div>
        
    ))}
</nav>

<nav id="menu-lateral-types" class="submenus-lateral" aria-label="Menú lateral de tipos de producto">
    <section class="menu-lateral-title">
        <button  class="cursor-pointer" id="boton-menu-type-left" aria-label="Cerrar submenú de tipos de producto">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        <h2>Tipos de producto</h2>
    </section>
        
    {typeProducts.map((type) => (
        <hr class="separator-menu" />
        <div class="div-menu-lateral">
            <a href={`/product-types/${type.name}`}>{type.name}</a>
        </div>
        
    ))}
</nav>

<nav id="menu-lateral-sch" class="menu-lateral-sch" aria-label="Menú lateral de búsqueda">
    <section class="section-search">
        <h2 class="h2-menu-search">Buscar</h2>
        <hr class="separator-menu" />
        <section class="section-input">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="input-search" class="input-search" placeholder="Buscar " type="search" name="q" 
            aria-label="Buscar" autocapitalize="off" autocomplete="off" spellcheck="false">
        </section>
        <section class="name-filters-search">
            <button class="name-filters selected" data-filter="productos">Productos</button>
            <button class="name-filters" data-filter="marcas">Marcas</button>
        </section>
    </section>
    <section class="search-results">
        {products.map((product) => (
            <div class="div-product-article-searcher" data-nombre={product.name.toLowerCase()} hidden>
                <a href={`/products/${product.id}`} class="product-article-searcher">
                <img class="img-product-searcher" src={product.image} loading="lazy" decoding="async"/>
                <div class="product-info-searcher pt-2">
                    <h2 class="title-product-article-searcher">{product.name}</h2>
                    <h3>{product.price.toFixed(2)}€</h3>
                </div>
            </a>
            <hr class="separator-menu my-2"/>
            </div>
        ))}
        <p class="texts-searcher" id="begin-text-searcher">
            Escriba el nombre del producto para encontrar coincidencias.
        </p>
        <p class="texts-searcher" id="sin-resultados" hidden>
            No se encontraron productos.
        </p>
    </section>
</nav>

<script>
    const actualizarBloqueoPagina = () => {
        const overlay = document.querySelector<HTMLElement>("#menu-overlay");
        const hayMenuAbierto = Boolean(document.querySelector(
            ".menu-lateral-opt.abierto, .submenus-lateral.abierto, .menu-lateral-sch.abierto"
        ));

        overlay?.classList.toggle("visible", hayMenuAbierto);
        overlay?.setAttribute("aria-hidden", String(!hayMenuAbierto));
        document.body.classList.toggle("menu-abierto", hayMenuAbierto);
    };
    document.addEventListener("astro:page-load", () => {//el astro:page-load permite que después de navegar sigan funcionando los efectos
        // menú opciones
        const buttonMenuOpt = document.querySelector<HTMLButtonElement>("#boton-menu-opt");
        const menuLateralOpt = document.querySelector<HTMLElement>("#menu-lateral-opt");
        const iconoMenuOpt = buttonMenuOpt?.querySelector<HTMLElement>("i");

        // menú marcas
        const buttonMenuBra = document.querySelector<HTMLButtonElement>("#button-menu-brands");
        const menuLateralBra = document.querySelector<HTMLElement>("#menu-lateral-brands");
        const buttonMenuBraLeft = document.querySelector<HTMLElement>("#boton-menu-bra-left");
        
        //menu tipos
        const buttonMenuType = document.querySelector<HTMLButtonElement>("#button-menu-types");
        const menuLateralType = document.querySelector<HTMLElement>("#menu-lateral-types");
        const buttonMenuTypeLeft = document.querySelector<HTMLElement>("#boton-menu-type-left");

        const menusLaterales = document.querySelectorAll<HTMLElement>(
            ".menu-lateral-opt, .submenus-lateral, .menu-lateral-sch"
        );
        const observadorMenus = new MutationObserver(actualizarBloqueoPagina);
        menusLaterales.forEach((menu) => {
            observadorMenus.observe(menu, { attributes: true, attributeFilter: ["class"] });
        });
        actualizarBloqueoPagina();
        // menú opciones
        buttonMenuOpt?.addEventListener("click", () => {
            if (!menuLateralOpt) return;

            menuLateralOpt.classList.toggle("abierto");
            const isOpen = menuLateralOpt.classList.contains("abierto");

            buttonMenuOpt.setAttribute("aria-expanded", String(isOpen));
            buttonMenuOpt.setAttribute(
                "aria-label",
                isOpen ? "Cerrar menú" : "Abrir menú"
            );

            iconoMenuOpt?.classList.toggle("fa-bars", !isOpen);
            iconoMenuOpt?.classList.toggle("bi-x-lg", isOpen);
            menuLateralBra?.classList.remove("abierto");
            buttonMenuBra?.setAttribute("aria-expanded", String(isOpen));
            menuLateralType?.classList.remove("abierto");
            buttonMenuType?.setAttribute("aria-expanded", String(isOpen));
        });
        // menú marcas
        buttonMenuBra?.addEventListener("click", () => {
            if (!menuLateralBra) return;

            menuLateralBra.classList.toggle("abierto");
            const isOpenBra = menuLateralBra.classList.contains("abierto");

            buttonMenuBra.setAttribute("aria-expanded", String(isOpenBra));
            buttonMenuBra.setAttribute(
                "aria-label",
                isOpenBra ? "Cerrar menú" : "Abrir menú"
            );
        });
        buttonMenuBraLeft?.addEventListener("click", () => {
            if (!menuLateralBra) return;

            menuLateralBra.classList.toggle("abierto");
            const isOpenBra = menuLateralBra.classList.contains("abierto");

            buttonMenuBra?.setAttribute("aria-expanded", String(isOpenBra));
            buttonMenuBra?.setAttribute(
                "aria-label",
                isOpenBra ? "Cerrar menú" : "Abrir menú"
            );
        });

        //menu tipos
        buttonMenuType?.addEventListener("click", () => {
            if (!menuLateralType) return;

            menuLateralType.classList.toggle("abierto");
            const isOpenType = menuLateralType.classList.contains("abierto");

            buttonMenuType.setAttribute("aria-expanded", String(isOpenType));
            buttonMenuType.setAttribute(
                "aria-label",
                isOpenType ? "Cerrar menú" : "Abrir menú"
            );
        });
        buttonMenuTypeLeft?.addEventListener("click", () => {
            if (!menuLateralType) return;

            menuLateralType.classList.toggle("abierto");
            const isOpenType = menuLateralType.classList.contains("abierto");

            buttonMenuType?.setAttribute("aria-expanded", String(isOpenType));
            buttonMenuType?.setAttribute(
                "aria-label",
                isOpenType ? "Cerrar menú" : "Abrir menú"
            );
        });

        //para los enlace contacto y sobre nosotros
        const linksCerrarMenu = document.querySelectorAll<HTMLAnchorElement>(".link-cerrar-menu");
        linksCerrarMenu.forEach((link) => {
            link.addEventListener("click", () => {
                menuLateralOpt?.classList.remove("abierto");

                iconoMenuOpt?.classList.toggle("fa-bars", true);
                iconoMenuOpt?.classList.toggle("bi-x-lg", false);

                buttonMenuOpt?.setAttribute("aria-expanded", "false");
                buttonMenuOpt?.setAttribute("aria-label", "Abrir menú");
            });
        });

        
    });

    //menú busqueda
    document.addEventListener("astro:page-load", () => {//el astro:page-load permite que después de navegar sigan funcionando los efectos
        const buttonMenuSch = document.querySelector<HTMLButtonElement>("#boton-menu-sch");
        const menuLateralSch = document.querySelector<HTMLElement>("#menu-lateral-sch");
        const iconoMenuch = buttonMenuSch?.querySelector<HTMLElement>("i");
        const overlay = document.querySelector<HTMLElement>("#menu-overlay");

        const actualizarBuscador = (isOpen: boolean) => {
            buttonMenuSch?.setAttribute("aria-expanded", String(isOpen));
            buttonMenuSch?.setAttribute(
                "aria-label",
                isOpen ? "Cerrar menú" : "Abrir menú"
            );

            iconoMenuch?.classList.toggle("fa-magnifying-glass", !isOpen);
            iconoMenuch?.classList.toggle("bi-x-lg", isOpen);
        };
        
        buttonMenuSch?.addEventListener("click", () => {
            if (!menuLateralSch) return;

            menuLateralSch.classList.toggle("abierto");
            const isOpen = menuLateralSch.classList.contains("abierto");

            actualizarBuscador(isOpen);
        });

        overlay?.addEventListener("click", () => {
            document.querySelectorAll<HTMLElement>(
                ".menu-lateral-opt, .submenus-lateral, .menu-lateral-sch"
            ).forEach((menu) => menu.classList.remove("abierto"));

            actualizarBuscador(false);

            const buttonMenuOpt = document.querySelector<HTMLButtonElement>("#boton-menu-opt");
            const iconoMenuOpt = buttonMenuOpt?.querySelector<HTMLElement>("i");
            buttonMenuOpt?.setAttribute("aria-expanded", "false");
            buttonMenuOpt?.setAttribute("aria-label", "Abrir menú");
            iconoMenuOpt?.classList.add("fa-bars");
            iconoMenuOpt?.classList.remove("bi-x-lg");

            document.querySelectorAll<HTMLButtonElement>(
                "#button-menu-brands, #button-menu-types"
            ).forEach((button) => button.setAttribute("aria-expanded", "false"));

            actualizarBloqueoPagina();
        });
    });

    //buscador
    document.addEventListener("astro:page-load", () => {//el astro:page-load permite que después de navegar sigan funcionando los efectos
        const search = document.querySelector<HTMLInputElement>("#input-search");

        const products = document.querySelectorAll<HTMLElement>(".div-product-article-searcher");

        const mensajeSinResultados = document.querySelector<HTMLElement>("#sin-resultados");
        const beginText = document.querySelector<HTMLElement>("#begin-text-searcher");

        search?.addEventListener("input", () => {
            const searchedEle = search.value.toLowerCase().trim();
            let visibleProducts = 0;

            
            products.forEach((product) => {
                const name = product.dataset.nombre ?? "";

                const finds = name.includes(searchedEle);

                if(searchedEle.length > 2) product.hidden = !finds;
                else product.hidden = true;

                if (finds) {
                    visibleProducts++;
                }
            });
            
            if(searchedEle.length < 3) visibleProducts = 0; 
            if (beginText) {
                beginText.hidden = visibleProducts > 0 || searchedEle.length > 2;
            }

            if (mensajeSinResultados ) {
                mensajeSinResultados.hidden = visibleProducts > 0 || searchedEle.length < 3;
            }
        });

        const filters = document.querySelectorAll<HTMLButtonElement>(".name-filters");
        filters.forEach((filter) => {
            filter.addEventListener("click", () => {
                filters.forEach((others) => {
                    others.classList.remove("selected");
                });
                filter.classList.add("selected");
                const activefilter = filter.dataset.filter;
            });
        });
    });

</script>

<style>
    .header {
        background-color: #964794;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        max-height: 95px;
        
        align-items: center;

        position: sticky;
        top: 0;
        z-index: 1100;
        min-height: 80px;
        width: 100%;
    }
    
    .header-options {
        text-align: left;
        font-size: 2.3rem;
        margin-left: 1.5rem;
    }

    .header-search {
        text-align: right;
        font-size: 1.9rem;
        margin-right: 1.5rem;
    }

    .header-options i,
    .header-search i {
        cursor: pointer;
        transition: color 0.2s ease;
        color: #FFE11F;
    }

    .header-options i:hover,
    .header-search i:hover {
        color: #FFF4C2;
    }

    .header-logo img {
        display: block;
        width: min(100%, 500px);
        max-height: 95px;
        object-fit: contain;
    }

    .menu-lateral-opt,
    .submenus-lateral {
        overflow-y: auto;
        overflow-x: hidden;
    }

    .menu-overlay {
        position: fixed;
        inset: 80px 0 0;
        z-index: 999;

        background-color: rgb(0 0 0 / 40%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transition:
            opacity 0.3s ease,
            visibility 0.3s ease;
    }

    .menu-overlay.visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    :global(body.menu-abierto) {
        overflow: hidden;
    }

    .menu-lateral-opt {
        position: fixed;
        top: 80px;
        left: 0;
        z-index: 1000;

        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        width: 280px;
        height: calc(100vh - 80px);
        padding-top: 2rem;

        background-color: white;
        box-shadow: 4px 0 12px rgb(0 0 0 / 20%);

        /* Inicialmente queda oculto hacia la izquierda */
        transform: translateX(-100%);
        transition: transform 0.3s ease;

        color: #41444a
    }

    .menu-lateral-opt.abierto {
        transform: translateX(0);
    }

    .menu-lateral-opt a,
    .menu-lateral-opt button {
        font-weight: 500;
        cursor: pointer;
        padding-left: 10%;
        font-size: 1.15rem;
    }

    .buttons-open-submenus {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-right: 10%;
    }

    .submenus-lateral {
        position: fixed;
        top: 80px;
        left: 0;
        z-index: 1000;

        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        width: 280px;
        height: calc(100vh - 80px);
        padding-top: 2rem;

        background-color: white;
        box-shadow: 4px 0 12px rgb(0 0 0 / 20%);

        /* Inicialmente queda oculto hacia la izquierda */
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        color: #41444a
    }   

    .submenus-lateral.abierto {
        transform: translateX(0);
    }

    .div-menu-lateral {
        display: flex;
        flex-direction: row;
        align-items: center;
        height: 3%;
    }
    .submenus-lateral a {
        font-weight: 500;
        cursor: pointer;
        padding-left: 10%;
        font-size: 1.15rem;
    }

    .menu-lateral-title {
        padding-left: 10%;
        display: flex;
        flex-direction: row;
        align-items: center;
        font-weight: 500;
        gap: 10%;
        font-size: 1.35rem;
    }

    .submenus-lateral a:hover,
    .menu-lateral-opt a:hover,
    .menu-lateral-opt button:hover,
    .menu-lateral-title button:hover {
        transition: color 0.2s ease;
        color: #964794;
    }

    .menu-lateral-sch {
        position: fixed;
        top: 80px;
        right: 0;
        z-index: 1000;

        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        width: 320px;
        height: calc(100vh - 80px);
        padding-top: 2rem;

        background-color: white;
        box-shadow: -4px 0 12px rgb(0 0 0 / 20%);

        /* Inicialmente queda oculto hacia la derecha */
        transform: translateX(100%);
        transition: transform 0.3s ease;

        color: #41444a
    }

    .menu-lateral-sch.abierto {
        transform: translateX(0);
    }

    .search-results {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
    }

    .section-search {
        display: flex;
        flex-direction: column;
        gap: 1rem;       
    }

    .section-input {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: center;
        padding-left: 1.5rem;
        font-size: 1.3rem;
    }
    .h2-menu-search {
        font-size: 1.5rem;
        font-weight: 600;
        text-align: center;
    }
    .input-search {
        border: 1px solid #000000;
        border-radius: 12px;
        width: 80%;
        padding: 0.3rem;
    }

    .name-filters-search {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        padding: 3% 20%;
    }

    .name-filters {
        font-weight: 500;
        cursor: pointer;
    }

    .name-filters.selected {
        text-decoration: underline;
    }
    .name-filters:hover {
        transition: color 0.2s ease;
        color: #964794;
    }

    .div-product-article-searcher {
        display: contents;
    }

    .product-article-searcher {
        height: 22%;
        display: flex;
        flex-direction: row;
        gap: 10%;
        padding-left: 5%;
        font-weight: 500;
        font-size: 1.1rem;
    }

    .img-product-searcher {
        height: 100%;
    }

    .product-info-searcher {
        flex: 1;
        min-width: 0;
    }

    .title-product-article-searcher {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

    .texts-searcher {
        text-align: center;
    }

</style>
