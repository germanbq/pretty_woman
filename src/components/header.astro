---
import SideMenuOpt from './side-menu-opt.astro'
import SideSubmenu from './side-submenu.astro'
import SearchMenu from './search-submenu.astro';

import '../styles/styles.css'
---
<header>
    <button class="header-options" id="opt-menu-button" aria-label="Abrir menú de opciones" aria-expanded="false">
        <i class="fa-solid fa-bars"></i>
    </button>
    <a class="header-logo" href="/" data-astro-reload><!--el último atributo sirve para evitar pasar por el ClientRouter y no procesa todos las tarjetas de prodcutos al volver -->
        <img src={"/images/logo_header.webp"} alt="Logo del header"/>
    </a>
    <button class="header-search" id="sch-menu-button" aria-label="Abrir menú de búsqueda" aria-expanded="false">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
</header>

<SideMenuOpt />
<SideSubmenu type="Marcas" menuId="brands-side-menu" closeButtonId="brand-menu-left-button"/>
<SideSubmenu type="Tipos de producto" menuId="types-side-menu" closeButtonId="type-menu-left-button"/>
<SearchMenu />

<script>
    document.addEventListener("astro:page-load", () => {//el astro:page-load permite que después de navegar sigan funcionando los efectos
        // menú opciones
        const optMenuButton = document.querySelector<HTMLButtonElement>("#opt-menu-button");
        const optSideMenu = document.querySelector<HTMLElement>("#opt-side-menu");
        const optMenuIcon = optMenuButton?.querySelector<HTMLElement>("i");

        // menú marcas
        const brandButtonMenu = document.querySelector<HTMLButtonElement>("#brands-menu-button");
        const brandSideMenu = document.querySelector<HTMLElement>("#brands-side-menu");
        
        //menu tipos
        const typeMenuButton = document.querySelector<HTMLButtonElement>("#types-menu-button");
        const typeSideMenu = document.querySelector<HTMLElement>("#types-side-menu");
        
        // menú opciones
        optMenuButton?.addEventListener("click", () => {
            if(!optSideMenu) return;

            optSideMenu.classList.toggle("open");
            const isOpen = optSideMenu.classList.contains("open");

            optMenuButton.setAttribute("aria-expanded", String(isOpen));
            optMenuButton.setAttribute("aria-label",
                isOpen ? "Cerrar menú" : "Abrir menú"
            );

            optMenuIcon?.classList.toggle("fa-bars", !isOpen);
            optMenuIcon?.classList.toggle("bi-x-lg", isOpen);
            brandSideMenu?.classList.remove("open");
            brandButtonMenu?.setAttribute("aria-expanded", "false");
            typeSideMenu?.classList.remove("open");
            typeMenuButton?.setAttribute("aria-expanded", "false");
        });
        
        //para los enlaces contacto y sobre nosotros
        const closeMenuLinks = document.querySelectorAll<HTMLAnchorElement>(".close-menu-link");
        closeMenuLinks.forEach((link) => {
            link.addEventListener("click", () => {
                optSideMenu?.classList.remove("open");

                optMenuIcon?.classList.toggle("fa-bars", true);
                optMenuIcon?.classList.toggle("bi-x-lg", false);

                optMenuButton?.setAttribute("aria-expanded", "false");
                optMenuButton?.setAttribute("aria-label", "Abrir menú");
            });
        });

        
    });
</script>

<style>
    header {
        background-color: #964794;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        max-height: 95px;
        
        align-items: center;

        position: sticky;
        top: 0;
        z-index: 1100;
        min-height: 80px;
        width: 100%;
    }
    
    .header-options {
        text-align: left;
        font-size: 2.3rem;
        margin-left: 1.5rem;
    }

    .header-search {
        text-align: right;
        font-size: 1.9rem;
        margin-right: 1.5rem;
    }

    .header-options i,
    .header-search i {
        cursor: pointer;
        transition: color 0.2s ease;
        color: #FFE11F;
    }

    .header-options i:hover,
    .header-search i:hover {
        color: #FFF4C2;
    }

    .header-logo img {
        display: block;
        width: min(100%, 500px);
        max-height: 95px;
        object-fit: contain;
    }
</style>
