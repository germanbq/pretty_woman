---
---
<main>
    <svg
        class="footer-transition"
        viewBox="0 0 1440 120"
        preserveAspectRatio="none"
        aria-hidden="true"
    >
        <path d="M0 72C220 112 405 28 640 52C875 76 1045 118 1240 82C1325 66 1390 48 1440 40V120H0V72Z"></path>
    </svg>
    <section class="footer">
        <img src={"/images/logo.webp"} alt="Logo"/>
        <div class="footer-map">
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3040.625802522174!2d-3.694129323956049!3d40.35064627145044!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd422700081614eb%3A0x64fb34d9a6d1dccd!2sPRETTY%20WOMAN!5e0!3m2!1ses!2ses!4v1786365677054!5m2!1ses!2ses" 
                width="550" height="412" style="border:0;" allowfullscreen="" loading="lazy" 
                referrerpolicy="strict-origin-when-cross-origin">
            </iframe>
        </div>
    </section>
</main>

<style>
    .footer {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: center;
        gap: clamp(1rem, 4vw, 4rem);
        padding: 2rem clamp(1rem, 4vw, 4rem);
        background-color: #964794;
    }

    .footer-transition {
        display: block;
        width: 100%;
        height: clamp(4rem, 8vw, 7.5rem);
        margin-bottom: -1px;
        fill: #964794;
    }

    .footer img {
        display: block;
        width: 100%;
        max-width: 450px;
        height: auto;
        margin: 0 auto;
        object-fit: contain;
    }

    .footer-map {
        min-width: 0;
    }

    .footer-map iframe {
        display: block;
        width: 100%;
        height: clamp(200px, 28vw, 360px);
        border-radius: 18px;
    }

    @media (max-width: 700px) {
        .footer {
            gap: 1rem;
            padding: 1.5rem 1rem;
        }

        .footer-map iframe {
            height: clamp(180px, 40vw, 280px);
        }
    }

    @media (max-width: 480px) {
        .footer {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .footer img {
            max-width: 300px;
        }

        .footer-map iframe {
            height: 260px;
        }
    }
</style>
