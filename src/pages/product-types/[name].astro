---
import productTypes from '../../data/product-types.json'
import products from '../../data/products.json'

import Layout from '../../layouts/Layout.astro';
import ProductCatalogs from '../../components/product-catalogs.astro';

export function getStaticPaths() {
    return productTypes.map((productType) => ({
        params: {
            name: productType.name
        },
        props: {
            productType: productType
        }
    })); 
}

interface ProductType {
    id: string;
    name: string;
    image: string;
    counts: Record<string, number>;
}

const{ name, image, id, counts } = Astro.props.productType as ProductType;

const PRODUCTS_PER_BATCH = 16;
const filterProductTypes = products.filter((product) => product.type === name);
const initialProducts = filterProductTypes.slice(0, PRODUCTS_PER_BATCH);
const remainingProducts = filterProductTypes.slice(PRODUCTS_PER_BATCH);
---

<Layout>
    <h2 class="card-h2" style="margin-top: 1rem;" transition:name={`name-${id}`}>{name}</h2>
    <ProductCatalogs filter="brand" id={id} name={name} image={image} counts={counts} initialProducts={initialProducts} remainingProducts={remainingProducts}/>
</Layout>