---
import productTypes from '../../data/product-types.json';
import products from '../../data/products.json';

import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/product-card.astro';

import "../../styles/styles.css";

export function getStaticPaths() {
    return productTypes.map((productType) => ({
        params: {
            name: productType.name
        },
        props: {
            productType: productType
        }
    })); 
}

const{ name, image, id } = Astro.props.productType;

const PRODUCTS_PER_BATCH = 20;
const typeProducts = products.filter((product) => product.type === name);
const initialProducts = typeProducts.slice(0, PRODUCTS_PER_BATCH);
const remainingProducts = typeProducts.slice(PRODUCTS_PER_BATCH);
---

<Layout>
    <h2 class="card-h2" style="margin-top: 1rem;" transition:name={`name-${id}`}>{name}</h2>
    <img src={image} alt={name} class="brand-image" transition:name={`img-${id}`}/>
    <hr class="separator" />
    <div class="cards-grid">
        {initialProducts.map((product) => (
            <a href={`/products/${product.id}`} class="card-link">
				<ProductCard name={product.name} imageUrl={product.image} price ={product.price} id={product.id} />
			</a>
        ))}
    </div>

    {remainingProducts.length > 0 && (
        <>
        <template id="remaining-products">
            {remainingProducts.map((product) => (
                <a href={`/products/${product.id}`} class="card-link">
				    <ProductCard name={product.name} imageUrl={product.image} price ={product.price} id={product.id} />
			    </a>
            ))}
        </template>

        <button id="load-more" type="button"> Cargar más</button>
        </>
    )}
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const PRODUCTS_PER_BATCH = 20;
        const grid = document.querySelector<HTMLElement>(".cards-grid");
        const template = document.querySelector<HTMLTemplateElement>("#remaining-products");
        const loadMore = document.querySelector<HTMLButtonElement>("#load-more");

        loadMore?.addEventListener("click", () => {
            if(!grid || !template) return;

            const nextProd = Array.from(template.content.children).slice(0, PRODUCTS_PER_BATCH);
            nextProd.forEach((product) => grid.append(product));
            if (template.content.children.length === 0) {
                loadMore.remove();
            }
        });
    })
</script>

<style>
    .brand-image {
        display: block;
        margin: 0 auto;
        max-width: 300px;
        width: 100%;
        height: auto;
        border-radius: 18px;
    }
</style>

