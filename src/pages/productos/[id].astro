---
import Layout from '../../layouts/Layout.astro'
import BackArrow from '../../components/back-arrow.astro'
import type { Product } from "../../data-access/interfaces";
import { getAllProducts } from "../../data-access/querys";
import { slugify } from "../../scripts/slugify";

export async function getStaticPaths() {
    const products = await getAllProducts();
    return products.map((product: Product) => ({
        params: {
            id: `${slugify(product.name)}-${product.id}`
        },
        props: {
            product: product
        }
    }));
}

const { id, name, image_path, description, price, brand, type } = Astro.props.product as Product;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  description,
  image: image_path,
  brand: {
    "@type": "Brand",
    name: brand
  },
  category: type,
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: Number(price)
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: "/"
    },
    {
      "@type": "ListItem",
      position: 2,
      name: type,
      item: `/tipos-producto/${slugify(type)}`
    },
    {
      "@type": "ListItem",
      position: 3,
      name
    }
  ]
};
---

<Layout title={`Producto ${name} en Madrid | Pretty Woman`} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)}/>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}/>
    <BackArrow />
    <section class="product-detail">
        <aside class="product-image-container">
           <img class="product-image" src={image_path} alt={name} transition:name={`img-${id}-${name}`}/>
        </aside>
        <div class="product-information">
            <h1 class="product-title" transition:name={`name-${id}-${name}`}>{name}</h1>
            <p class="product-meta">
                <a href={`/marcas/${brand}`}>{brand}</a>
                ·
                <a href={`/tipos-producto/${type}`}>{type}</a>
            </p>
            <p class="product-price">{Number(price).toFixed(2)}€</p>
        </div>
        <div class="prose prose-stone product-description">
            <p>{description}</p>
        </div>
    </section>
</Layout>

<style>
    .product-detail {
        width: min(100% - 3rem, 1000px);
        margin: 0 auto;
        padding: 3rem 0;
        box-sizing: border-box;

        display: grid;
        grid-template-columns: 350px minmax(0, 540px);
        justify-content: center;
        align-items: start;

        gap: 0 1rem;
    }

    .product-image-container {
        display: flex;
        justify-content: center;
        overflow: hidden;
        border-radius: 18px;
        grid-row: 1/3;
    }

    .product-image {
        display: block;
        width: 100%;
        max-width: 320px;
        height: auto;
        object-fit: contain;
        border-radius: inherit;
    }

    .product-information {
        width: 100%;
        max-width: 750px;

        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .product-title {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 4vw, 2.5rem);
        line-height: 1.15;
        font-weight: 500;
    }

    .product-price {
        margin: 0 0 1.5rem;
        font-size: 1.55rem;
        font-weight: 400;
    }

    .product-meta {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin: 0;
        color: #6b7280;
        font-size: 0.95rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .product-meta a {
        color: inherit;
        font-weight: 500;
        text-decoration: underline;
        text-decoration-color: #d1d5db;
        text-underline-offset: 4px;
        transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }

    

    .product-meta a:hover,
    .product-meta a:focus-visible {
        color: #964794;
        text-decoration-color: currentColor;
    }

    .product-meta a:focus-visible {
        outline: none;
    }

    @media (max-width: 780px) {

        .product-detail {
            margin-top: 1rem;
            grid-template-columns: minmax(0,1fr) minmax(0, 1fr);
            grid-template-areas: 
                "informacion descripcion"
                "imagen descripcion"
                "imagen ."
            
        }
        .product-image-container {
            grid-area: imagen; 
            margin-top: 1rem;
        }

        .product-information {
            grid-area: informacion;
        }

        .product-description {
            grid-area: descripcion;
        }

        .product-information .product-title,
        .product-information .product-price {
            margin-bottom: 0;
        }

        .product-information {
           text-align: center;
        }

        .product-meta {
            justify-content: center;
        }
    }
    @media (max-width: 480px) {
        .product-detail {
            grid-template-columns: 1fr;
            grid-template-areas:
                "informacion"
                "imagen"
                "descripcion";
            margin-top: 0;
            padding-top: 0;
        }

    }
</style>
