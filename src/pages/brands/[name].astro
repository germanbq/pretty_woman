---
import brands from '../../data/brands.json';
import products from '../../data/products.json';

import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/product-card.astro';

import "../../styles/styles.css";

export function getStaticPaths() {
    return brands.map((brand) => ({
        params: {
            name: brand.name
        },
        props: {
            brand: brand
        }
    })); 
}

const{ name, image, id } = Astro.props.brand;
---

<Layout>
    <a href="/">
        <i class="fa-solid fa-arrow-left arrow-left"></i>
    </a>
    <img src={image} alt={name} class="brand-image" transition:name={`img-${id}`}/>
    <hr class="separator" />
	<div class="cards-grid">
		{products.filter((product) => product.brand === name).map((product) => (
			<a href={`/products/${product.id}`} class="card-link">
				<ProductCard name={product.name} imageUrl={product.image} price ={product.price} id={product.id} />
			</a>
		))}
    </div>
</Layout>

<style>
    .brand-image {
        display: block;
        margin: 0 auto;
        max-width: 300px;
        width: 100%;
        height: auto;
        border-radius: 18px;
    }

    .separator {
        width: 90%;
        margin: 0 auto 2rem auto;
        border: none;
        height: 1px;
        background-color: #000000;
    }
</style>

