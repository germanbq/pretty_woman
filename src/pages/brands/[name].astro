---
import brands from '../../data/brands.json'
import products from '../../data/products.json'

import Layout from '../../layouts/Layout.astro'
import ProductCatalogs from '../../components/product-catalogs.astro'

export function getStaticPaths() {
    return brands.map((brand) => ({
        params: {
            name: brand.name
        },
        props: {
            brand: brand
        }
    })); 
}

interface Brand {
    id: string;
    name: string;
    image: string;
    counts: Record<string, number>;
}

const{ name, image, id, counts } = Astro.props.brand as Brand;
const PRODUCTS_PER_BATCH = 16;
const brandProducts = products.filter((product) => product.brand === name);
const initialProducts = brandProducts.slice(0, PRODUCTS_PER_BATCH);
const remainingProducts = brandProducts.slice(PRODUCTS_PER_BATCH);
---

<Layout>
    <ProductCatalogs filter="type" id={id} name={name} image={image} counts={counts} initialProducts={initialProducts} remainingProducts={remainingProducts}/>
</Layout>