---
import Layout from '../layouts/Layout.astro'

import Contact from '../components/contact.astro'
import ProductCard from '../components/product-card.astro'

import { getAllBrands, getAllProductTypes } from '../data-access/querys'

const brands = await getAllBrands();
const productTypes = await getAllProductTypes();

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Pretty Woman",
  telephone: "+34640246413",
  address: {
    "@type": "PostalAddress",
    streetAddress: "José del Pino, 6",
    addressLocality: "Madrid",
    addressRegion: "Madrid",
    addressCountry: "ES"
  }
};
---
<Layout title={`Productos profesionales de peluquería y cosmética en Villaverde, Madrid | Pretty Woman`} description="Productos profesionales de peluquería, cosmética y belleza en Villaverde, Madrid. Descubre nuestras marcas y catálogo.">
	<script type="application/ld+json" set:html={JSON.stringify(storeSchema)}/>
	<div>
		<h1> Productos profesionales de peluquería y cosmética en Villaverde</h1>
		<h2>Marcas</h2>
		<div class="cards-grid">
			{brands.map((brand) => (
				<a href={`/marcas/${brand.name}`} class="card-link">
					<ProductCard name={brand.name} imageUrl={brand.image_path} id={brand.id} />
				</a>
			))}
		</div>
		<h2>Tipos de producto</h2>
		<div class="cards-grid">
			{productTypes.map((productType) => (
				<a href={`/tipos-producto/${productType.name}`} class="card-link">
				<ProductCard name={productType.name} imageUrl={productType.image_path} id={productType.id} />
				</a>
			))}
		</div>
	</div>
	<hr class="separator" />
	<Contact />
</Layout>

<style>
	h2, h1 {
		margin: 1.5rem auto 0.5rem;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: #0f172a;
		position: relative;
		display: block;
		text-align: center;
		width: fit-content;
		background: linear-gradient(90deg, #7c3aed, #f472b6);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}
</style>
