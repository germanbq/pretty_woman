---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';
import productTypes from '../data/product-types.json';
import brands from '../data/brands.json';

import Footer from '../components/footer.astro';
import Contacto from '../components/contacto.astro';
import ProductCard from '../components/product-card.astro';

import "../styles/styles.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<div>
		<h2>Marcas</h2>
		<div class="cards-grid">
			{brands.map((brand) => (
				<a href={`/brands/${brand.name}`} class="card-link">
					<ProductCard name={brand.name} imageUrl={brand.image} id={brand.id} />
				</a>
			))}
		</div>
		<h2>Tipos de producto</h2>
		<div class="cards-grid">
			{productTypes.map((productType) => (
				<a href={`/product-types/${productType.name}`} class="card-link">
				<ProductCard name={productType.name} imageUrl={productType.image} id={productType.id} />
				</a>
			))}
		</div>
	</div>
	<hr class="separator" />
	<Contacto></Contacto>
</Layout>

<style>
	h2 {
		margin: 1.5rem auto 0.5rem;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: #0f172a;
		position: relative;
		display: block;
		text-align: center;
		width: fit-content;
	}

	h2::after {
		content: '';
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		bottom: -0.35rem;
		width: 70%;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(90deg, #7c3aed, #f472b6);
	}
</style>
