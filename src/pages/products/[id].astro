---
import Layout from '../../layouts/Layout.astro'
import type { Product } from "../../data-access/interfaces";
import { getAllProducts } from "../../data-access/querys";

export async function getStaticPaths() {
    const products = await getAllProducts();
    return products.map((product) => ({
        params: {
            id: product.id.toString()
        },
        props: {
            product: product
        }
    }));
}

const { id, name, image_path, description, price } = Astro.props.product as Product;
---

<Layout>
    <a>
        <button type="button" aria-label="Volver" id="arrow-left">
            <i class="fa-solid fa-arrow-left arrow-left"></i>
        </button>
    </a>
    <section class="product-detail">
        <aside class="product-image-container">
           <img class="product-image" src={image_path} alt={name} transition:name={`img-${id}`}/>
        </aside>
        <div class="product-information">
            <h1 class="product-title" transition:name={`name-${id}`}>{name}</h1>
            <p class="product-price">{Number(price).toFixed(2)}€</p>
        </div>
        <div class="prose prose-stone product-description">
            <p>{description}</p>
        </div>
    </section>
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const arrowLeft = document.querySelector<HTMLButtonElement>("#arrow-left");
        arrowLeft?.addEventListener("click", () => {
            history.back();
        });
    });
</script>

<style>
    .product-detail {
        width: min(100% - 3rem, 1000px);
        margin: 0 auto;
        padding: 3rem 0;
        box-sizing: border-box;

        display: grid;
        grid-template-columns: 350px minmax(0, 540px);
        justify-content: center;
        align-items: start;

        gap: 0 1rem;
    }

    .product-image-container {
        display: flex;
        justify-content: center;
        overflow: hidden;
        border-radius: 18px;
        grid-row: 1/3;
    }

    .product-image {
        display: block;
        width: 100%;
        max-width: 320px;
        height: auto;
        object-fit: contain;
        border-radius: inherit;
    }

    .product-information {
        width: 100%;
        max-width: 750px;

        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .product-title {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 4vw, 2.5rem);
        line-height: 1.15;
        font-weight: 500;
    }

    .product-price {
        margin: 0 0 1.5rem;
        font-size: 1.55rem;
        font-weight: 400;
    }

    .arrow-left {
        position: fixed;
        left: 4%;
        top: 140px;
        font-size: 1.2rem;
        cursor: pointer;
        z-index: 1100;
    }

    .arrow-left:hover {
        color: #964794;
    }

    @media (max-width: 780px) {

        .product-detail {
            margin-top: 1rem;
            grid-template-columns: minmax(0,1fr) minmax(0, 1fr);
            grid-template-areas: 
                "informacion descripcion"
                "imagen descripcion"
                "imagen ."
            
        }
        .product-image-container {
            grid-area: imagen; 
            margin-top: 1rem;
        }

        .product-information {
            grid-area: informacion;
        }

        .product-description {
            grid-area: descripcion;
        }

        .product-information .product-title,
        .product-information .product-price {
            margin-bottom: 0;
        }

        .product-information {
           text-align: center;
        }
    }
    @media (max-width: 480px) {
        .product-detail {
            grid-template-columns: 1fr;
            grid-template-areas:
                "informacion"
                "imagen"
                "descripcion";
            margin-top: 0;
            padding-top: 0;
        }

        .arrow-left {
            left: 2%;
            top: 100px;
        }
    }
</style>
